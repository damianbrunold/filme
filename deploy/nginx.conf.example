# Reverse proxy in front of filme. The app binds 127.0.0.1 only; nginx
# terminates TLS. Copy to /etc/nginx/sites-available/filme, adjust
# server_name and the certificate paths, enable, reload nginx.

upstream filme_backend {
    server 127.0.0.1:8072;
}

server {
    listen 80;
    server_name filme.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name filme.example.com;

    ssl_certificate     /etc/letsencrypt/live/filme.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/filme.example.com/privkey.pem;

    # Uploads arrive in chunks of 16 MiB; a video of any size is many
    # chunks, so this limit does not limit the video size.
    client_max_body_size 40m;
    # Pass chunks through as they arrive instead of buffering them on disk.
    proxy_request_buffering off;

    location / {
        proxy_pass         http://filme_backend;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Forwarded-For   $remote_addr;
        proxy_set_header   X-Forwarded-Proto $scheme;
        # Streaming a long video and slow uploads need more than the
        # default 60 s.
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        # Range requests (seeking) and large responses go straight through.
        proxy_buffering    off;
        proxy_max_temp_file_size 0;
    }
}
